@{
    ViewData["Title"] = "Access Denied";
}
<div class="row justify-content-center mt-5">
    <div class="col-lg-5 text-center">
        <div class="confirm-icon danger mx-auto mb-4"><i class="fa-solid fa-shield-halved"></i></div>
        <h2 style="font-family:'Playfair Display',serif">Access Denied</h2>
        <p class="text-muted mb-4">You do not have permission to access this section.</p>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Index" class="btn-artemis btn-primary-artemis"><i class="fa-solid fa-house"></i>Back to top</a>
        }
        else if (User.IsInRole("Cashier"))
        {
            <a asp-controller="Cashier" asp-action="Index" class="btn-artemis btn-primary-artemis"><i class="fa-solid fa-house"></i>Back to top</a>
        }
        else
        {
            <a asp-controller="Client" asp-action="Index" class="btn-artemis btn-primary-artemis"><i class="fa-solid fa-house"></i>Back to top</a>
        }
    </div>
</div>