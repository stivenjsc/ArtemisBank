@model EditLoanRateViewModel
@{
    ViewData["Title"] = "Edit Interest Rate";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="form-card">
            <h5 class="mb-4" style="font-family:'Playfair Display',serif">
                <i class="fa-solid fa-percent me-2" style="color:var(--emerald-600)"></i>
                Loan @Model.LoanNumber
            </h5>

            <div class="p-3 rounded-3 mb-4" style="background:var(--surface); border:1px solid rgba(0,0,0,.06)">
                <div class="d-flex justify-content-between" style="font-size:.85rem">
                    <span class="text-muted">Current rate</span>
                    <span class="money-value">@Model.CurrentAnnualInterestRate%</span>
                </div>
            </div>

            <form asp-controller="Loan" asp-action="EditRate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LoanId" />
                <input type="hidden" asp-for="LoanNumber" />

                <div class="mb-4">
                    <label class="form-label">New Annual Interest Rate (%)</label>
                    <div class="input-group">
                        <input asp-for="NewAnnualInterestRate" type="number" step="0.01" min="0" class="form-control" />
                        <span class="input-group-text bg-white">%</span>
                    </div>
                    <small class="text-muted mt-1 d-block">Only future unpaid installments will be recalculated</small>
                </div>

                <div class="d-flex gap-2 justify-content-between">
                    <a asp-controller="Loan" asp-action="Index" class="btn-artemis btn-ghost-artemis">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>
                    <button type="submit" class="btn-artemis btn-primary-artemis">
                        <i class="fa-solid fa-floppy-disk"></i> Update Rate
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>