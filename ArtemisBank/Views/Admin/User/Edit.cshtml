@model EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="breadcrumb-artemis mb-3">
    <a asp-controller="Admin" asp-action="Index">Home</a> /
    <a asp-controller="User" asp-action="Index">Users</a> / Edit
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="stat-icon mb-0">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>
                <div>
                    <h4 class="mb-0" style="font-family:'Playfair Display',serif">Edit user</h4>
                </div>
            </div>
            <form asp-controller="User" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">First Name</label>
                        <input asp-for="FirstName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Last Name</label>
                        <input asp-for="LastName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">ID Number</label>
                        <input asp-for="Cedula" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Password <small class="text-muted">(empty = no change)</small></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                    </div>
                    @if (Model.Role.ToString() == "Client")
                    {
                        <div class="col-12">
                            <div class="p-3 rounded-3" style="background:var(--emerald-50); border:1px solid var(--emerald-100)">
                                <label class="form-label">
                                    <i class="fa-solid fa-circle-plus me-1" style="color:var(--emerald-600)"></i>
                                    Additional amount to main account
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">RD$</span>
                                    <input asp-for="AdditionalAmount" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                                </div>
                                <small class="text-muted mt-1 d-block">This will be added to the current balance of the main account</small>
                            </div>
                        </div>
                    }
                </div>
                <hr class="divider my-4" />
                <div class="d-flex gap-2 justify-content-end">
                    <a asp-controller="User" asp-action="Index" class="btn-artemis btn-ghost-artemis">
                        <i class="fa-solid fa-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn-artemis btn-primary-artemis">
                        <i class="fa-solid fa-floppy-disk"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>