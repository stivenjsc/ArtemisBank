@model EditCreditCardLimitViewModel
@{
    ViewData["Title"] = "Edit Card Limit";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="form-card">
            <h5 class="mb-4" style="font-family:'Playfair Display',serif">
                <i class="fa-solid fa-credit-card me-2" style="color:var(--emerald-600)"></i>
                **** @Model.CardNumber.Substring(12)
            </h5>

            <div class="p-3 rounded-3 mb-4" style="background:var(--surface); border:1px solid rgba(0,0,0,.06)">
                <div class="d-flex justify-content-between mb-2" style="font-size:.85rem">
                    <span class="text-muted">Current limit</span>
                    <span class="money-value">RD$ @Model.CurrentCreditLimit.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between" style="font-size:.85rem">
                    <span class="text-muted">Amount owed</span>
                    <span class="money-value red">RD$ @Model.AmountOwed.ToString("N2")</span>
                </div>
            </div>

            <form asp-controller="CreditCard" asp-action="EditLimit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CardId" />
                <input type="hidden" asp-for="CardNumber" />
                <input type="hidden" asp-for="AmountOwed" />

                <div class="mb-4">
                    <label class="form-label">New Credit Limit</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">RD$</span>
                        <input asp-for="NewCreditLimit" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="NewCreditLimit" class="text-danger" style="font-size:.78rem"></span>
                    <small class="text-muted mt-1 d-block">Cannot be lower than the current debt</small>
                </div>

                <div class="d-flex gap-2 justify-content-between">
                    <a asp-controller="CreditCard" asp-action="Index" class="btn-artemis btn-ghost-artemis">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>
                    <button type="submit" class="btn-artemis btn-primary-artemis">
                        <i class="fa-solid fa-floppy-disk"></i> Update Limit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>