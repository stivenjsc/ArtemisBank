@model CashierDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Cashier";
}
<div class="breadcrumb-artemis mb-3">Start / Dashboard</div>
<div class="row g-3">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="fa-solid fa-arrow-right-arrow-left"></i>
            </div>
                <div class="stat-label">Today Transactions</div>
                <div class="stat-value">@Model.TodayTransactions</div>
            <div class="stat-sub">Just my daily transactions</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card gold">
            <div class="stat-icon">
                <i class="fa-solid fa-receipt"></i>
            </div>
                <div class="stat-label">Today Payments</div>
                <div class="stat-value">@Model.TodayPayments</div>
        </div>
        </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="fa-solid fa-arrow-down-to-bracket"></i>
            </div>
                <div class="stat-label">Today Deposits</div>
                <div class="stat-value">@Model.TodayDeposits</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card danger">
            <div class="stat-icon">
                <i class="fa-solid fa-arrow-up-from-bracket"></i>
            </div>
            <div class="stat-label">Today Withdrawals</div>
            <div class="stat-value">@Model.TodayWithdrawals</div>
        </div>
    </div>
</div>