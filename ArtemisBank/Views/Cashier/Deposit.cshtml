@model CashierDepositViewModel
@{
    ViewData["Title"] = "Deposit";
}
<div class="breadcrumb-artemis mb-3"><a asp-controller="Cashier" asp-action="Index">Start</a> / Deposit</div>
<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="form-card">
            <div class="d-flex align-items-center gap-3 mb-4"><div class="stat-icon mb-0"><i class="fa-solid fa-arrow-down-to-bracket"></i>
                </div><div><h4 class="mb-0" style="font-family:'Playfair Display',serif">Account deposit</h4></div>
            </div>
            @if (Model.HasError)
            {
                <div class="alert-artemis alert-artemis-danger mb-3"><i class="fa-solid fa-circle-exclamation"></i> @Model.Error</div>
            }
            <form asp-controller="Cashier" asp-action="Deposit" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3"><label class="form-label">Destination account number</label><input asp-for="AccountNumber" class="form-control" placeholder="10 dígitos" /></div>
                <div class="mb-4"><label class="form-label">Amount to deposit</label><div class="input-group"><span class="input-group-text bg-white">RD$
                </span><input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" /></div></div>
                <div class="d-flex gap-2 justify-content-between">
                    <a asp-controller="Cashier" asp-action="Index" class="btn-artemis btn-ghost-artemis"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
                    <button type="submit" class="btn-artemis btn-primary-artemis"><i class="fa-solid fa-arrow-right"></i> Continue</button>
                </div>
            </form>
        </div>
    </div>
</div>