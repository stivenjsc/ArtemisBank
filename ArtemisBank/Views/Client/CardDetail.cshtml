@model CardDetailViewModel
@{
    ViewData["Title"] = "Card Details";
}

<div class="breadcrumb-artemis mb-3">
    <a asp-controller="Client" asp-action="Index">My Banking</a> / Card Details
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Card No.</div>
            <div class="stat-value" style="font-size:.95rem;letter-spacing:2px">**** @Model.CreditCard.CardNumber.Substring(12)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Limit</div>
            <div class="stat-value money">@Model.CreditCard.CreditLimit.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card gold">
            <div class="stat-label">Amount Owed</div>
            <div class="stat-value money" style="color:var(--danger)">@Model.CreditCard.AmountOwed.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Expires</div>
            <div class="stat-value" style="font-size:1rem">@Model.CreditCard.ExpirationDate</div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h5>
            <i class="fa-solid fa-receipt me-2" style="color:var(--emerald-600)"></i>
            Registered Transactions
        </h5>
        <a asp-controller="Client" asp-action="Index" class="btn-artemis btn-ghost-artemis">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>

    <div class="table-responsive">
        <table class="artemis-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Merchant</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Consumptions)
                {
                    <tr>
                        <td>@c.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="money-value">RD$ @c.Amount.ToString("N2")</span></td>
                        <td>@c.CommerceName</td>
                        <td>
                            @if (c.Status.ToString() == "Approved")
                            {
                                <span class="badge-status badge-active">APPROVED</span>
                            }
                            else
                            {
                                <span class="badge-status badge-inactive">REJECTED</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>