@model AssignCreditCardViewModel
@{
    ViewData["Title"] = "Assign Credit Card";
}
<div class="breadcrumb-artemis mb-3">
    <a asp-controller="Admin" asp-action="Dashboard">Home</a> /
    <a asp-controller="CreditCard" asp-action="Index">Cards</a> / Assign
</div>

<div class="stat-card danger mb-4" style="max-width:320px">
    <div class="stat-icon"><i class="fa-solid fa-scale-balanced"></i></div>
    <div class="stat-label">System Average Debt</div>
    <div class="stat-value money">@Model.AverageDebt.ToString("N2")</div>
</div>

@if (Model.HasError)
{
    <div class="alert-artemis alert-artemis-danger mb-3">
        <i class="fa-solid fa-circle-exclamation"></i> @Model.Error
    </div>
}

<form method="post" asp-controller="CreditCard" asp-action="Assign">
    @Html.AntiForgeryToken()
    <div class="table-card mb-4">
        <div class="table-card-header">
            <h5><i class="fa-solid fa-users me-2" style="color:var(--emerald-600)"></i>Select Client</h5>
            <input type="text" name="cedula" value="@Model.CurrentCedula"
                   class="form-control form-control-sm" placeholder="Search by ID..." style="width:200px" />
        </div>
        <div class="table-responsive">
            <table class="artemis-table">
                <thead>
                    <tr><th style="width:40px"></th><th>ID Number</th><th>Full Name</th><th>Email</th><th>Current Debt</th></tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td>
                                <input type="radio" name="ClientId" value="@client.Id"
                                       class="form-check-input" style="width:18px;height:18px;accent-color:var(--emerald-600)" />
                            </td>
                            <td style="letter-spacing:1px">@client.Cedula</td>
                            <td>@client.FirstName @client.LastName</td>
                            <td>@client.Email</td>
                            <td>
                                <span class="money-value @(client.TotalDebt > Model.AverageDebt ? "red" : "green")">
                                    RD$ @client.TotalDebt
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="form-card">
                <h5 class="mb-4" style="font-family:'Playfair Display',serif">
                    <i class="fa-solid fa-credit-card me-2" style="color:var(--emerald-600)"></i>
                    Configure Card
                </h5>
                <div class="mb-4">
                    <label class="form-label">Credit Limit</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">RD$</span>
                        <input asp-for="CreditLimit" type="number" step="0.01" min="1"
                               class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="CreditLimit" class="text-danger" style="font-size:.78rem"></span>
                </div>
                <hr class="divider" />
                <div class="d-flex gap-2 justify-content-between">
                    <a asp-controller="CreditCard" asp-action="Index" class="btn-artemis btn-ghost-artemis">
                        <i class="fa-solid fa-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn-artemis btn-primary-artemis">
                        <i class="fa-solid fa-check"></i> Assign Card
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>