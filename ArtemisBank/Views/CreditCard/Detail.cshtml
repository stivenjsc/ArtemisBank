@model CreditCardDetailViewModel
@{
    ViewData["Title"] = "Card Details";
}

<div class="breadcrumb-artemis mb-3">
    <a asp-controller="Admin" asp-action="Dashboard">Home</a> /
    <a asp-controller="CreditCard" asp-action="Index">Cards</a> / Details
</div>

<div class="table-card">
    <div class="table-card-header">
        <h5>
            <i class="fa-solid fa-list me-2" style="color:var(--emerald-600)"></i>
            Transactions — **** @Model.CreditCard.CardNumber.Substring(12)
        </h5>
        <a asp-controller="CreditCard" asp-action="Index" class="btn-artemis btn-ghost-artemis">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>

    <div class="table-responsive">
        <table class="artemis-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Merchant</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Consumptions)
                {
                    <tr>
                        <td>@c.TransactionDate.ToString("MM/dd/yyyy HH:mm")</td>
                        <td>
                            <span class="money-value">RD$ @c.Amount.ToString("N2")</span>
                        </td>
                        <td>@c.CommerceName</td>
                        <td>
                            @if (c.Status.ToString("N2") == "Approved")
                            {
                                <span class="badge-status badge-active">Approved</span>
                            }
                            else
                            {
                                <span class="badge-status badge-danger">Declined</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>