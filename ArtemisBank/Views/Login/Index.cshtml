@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Artemis Banking</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Artemis.css" asp-append-version="true"/>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-logo"><i class="fa-solid fa-landmark"></i></div>
            <h1 class="login-title">Artemis Bank</h1>
            <p class="login-subtitle">Enter your credentials to log in</p>
            @if (TempData["Success"] != null)
            {
                <div class="alert-artemis alert-artemis-success mb-3"><i class="fa-solid fa-circle-check"></i> @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert-artemis alert-artemis-danger mb-3"><i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]</div>
            }
            @if (Model.HasError)
            {
                <div class="alert-artemis alert-artemis-danger mb-3"><i class="fa-solid fa-circle-exclamation"></i> @Model.Error</div>
            }
            <form asp-controller="Login" asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">User</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-regular fa-user text-muted" style="font-size:.85rem"></i></span>
                        <input asp-for="Username" class="form-control border-start-0" placeholder="Username" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger" style="font-size:.78rem"></span>
                </div>
                <div class="mb-4">
                    <label class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-lock text-muted" style="font-size:.85rem"></i></span>
                        <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:.78rem"></span>
                </div>
                <button type="submit" class="btn-artemis btn-primary-artemis w-100 justify-content-center py-2">
                    <i class="fa-solid fa-right-to-bracket"></i> Log in to the system
                </button>
            </form>
            <hr class="divider my-4" />
            <a asp-controller="Login" asp-action="ForgotPassword" class="d-flex align-items-center justify-content-center gap-2" style="color:var(--muted);font-size:.82rem;text-decoration:none">
                <i class="fa-solid fa-key" style="color:var(--emerald-600)"></i> Forgot Password
            </a>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
