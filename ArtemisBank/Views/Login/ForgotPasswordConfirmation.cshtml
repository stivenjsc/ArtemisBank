@{
    Layout = null;
    ViewData["Title"] = "Email Sent";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Artemis Banking</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/artemis.css" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-logo" style="background:linear-gradient(135deg,var(--emerald-700),var(--emerald-500))">
                <i class="fa-solid fa-envelope-circle-check"></i>
            </div>

            <h1 class="login-title">Check your email</h1>

            <p class="login-subtitle">
                We have sent you a link to reset your password.
                Please check your inbox.
            </p>

            <a asp-controller="Login" asp-action="Index"
               class="btn-artemis btn-primary-artemis w-100 justify-content-center py-2">
                <i class="fa-solid fa-arrow-left"></i> Back to Login
            </a>
        </div>
    </div>
</body>
</html>