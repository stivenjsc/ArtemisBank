@model ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>New Password</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/artemis.css" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-logo">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h1 class="login-title">New Password</h1>
            <p class="login-subtitle">Set your new access password</p>

            @if (Model.HasError)
            {
                <div class="alert-artemis alert-artemis-danger mb-3">
                    <i class="fa-solid fa-circle-exclamation"></i> @Model.Error
                </div>
            }

            <form asp-controller="Login" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label class="form-label">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="NewPassword" class="text-danger" style="font-size:.78rem"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:.78rem"></span>
                </div>

                <button type="submit" class="btn-artemis btn-primary-artemis w-100 justify-content-center py-2">
                    <i class="fa-solid fa-floppy-disk"></i> Save New Password
                </button>
            </form>
        </div>
    </div>
</body>
</html>