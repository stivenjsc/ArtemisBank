@model SavingsAccountDetailViewModel
@{
    ViewData["Title"] = "Account Details";
}

<div class="breadcrumb-artemis mb-3">
    <a asp-controller="Admin" asp-action="Dashboard">Home</a> /
    <a asp-controller="SavingsAccount" asp-action="Index">Savings Accounts</a> / Detail
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="form-card">
            <h5 class="mb-4" style="font-family:'Playfair Display',serif">
                <i class="fa-solid fa-piggy-bank me-2" style="color:var(--emerald-600)"></i>
                Account Details — @Model.Account.AccountNumber
            </h5>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="text-muted small d-block">Account Holder</label>
                    <p class="fw-bold">@Model.Account.OwnerFullName</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <label class="text-muted small d-block">Current Balance</label>
                    <h3 class="money-value green">RD$ @Model.Account.Balance.ToString("N2")</h3>
                </div>
            </div>

            <hr class="divider" />

            <h6 class="mb-3"><i class="fa-solid fa-list-ul me-2"></i>Recent Transactions</h6>

            <div class="table-responsive">
                <table class="artemis-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Transactions != null && Model.Transactions.Any())
                        {
                            foreach (var tx in Model.Transactions)
                            {
                                <tr>
                                    <td>@tx.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@tx.Description</td>
                                    <td>@tx.Type</td>
                                    <td class="text-end fw-bold @(tx.Amount < 0 ? "text-danger" : "text-success")">
                                        RD$ @tx.Amount.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">No transactions found for this account.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-4">
                <a asp-controller="SavingsAccount" asp-action="Index" class="btn-artemis btn-ghost-artemis">
                    <i class="fa-solid fa-arrow-left"></i> Return
                </a>
            </div>
        </div>
    </div>
</div>