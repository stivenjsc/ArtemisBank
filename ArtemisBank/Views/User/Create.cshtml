@model SaveUserViewModel
@{
    ViewData["Title"] = "New User";
}

<div class="breadcrumb-artemis mb-3">
    <a asp-controller="Admin" asp-action="Dashboard">Home</a> /
    <a asp-controller="User" asp-action="Index">Users</a> / Create
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="stat-icon mb-0">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <div>
                    <h4 class="mb-0" style="font-family:'Playfair Display',serif">New user</h4>
                    <p class="text-muted mb-0" style="font-size:.82rem">Complete all required fields</p>
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="alert-artemis alert-artemis-danger mb-3"></div>
            }

            <form asp-controller="User" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">First Name</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Maria" />
                        <span asp-validation-for="FirstName" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Last Name</label>
                        <input asp-for="LastName" class="form-control" placeholder="Santos" />
                        <span asp-validation-for="LastName" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">ID Number</label>
                        <input asp-for="Cedula" class="form-control" placeholder="001-1234567-8" />
                        <span asp-validation-for="Cedula" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="email@example.com" />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" placeholder="marias" />
                        <span asp-validation-for="Username" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">User Type</label>
                        <select asp-for="Role" class="form-select" id="roleSelect">
                            <option value="">Select role</option>
                            <option value="Admin">Administrator</option>
                            <option value="Cashier">Cashier</option>
                            <option value="Client">Client</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:.78rem"></span>
                    </div>

                    <div class="col-12" id="initialAmountSection" style="display:none">
                        <div class="p-3 rounded-3" style="background:var(--emerald-50); border:1px solid var(--emerald-100)">
                            <label class="form-label">
                                <i class="fa-solid fa-piggy-bank me-1" style="color:var(--emerald-600)"></i>
                                Initial Savings Account Amount
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">RD$</span>
                                <input asp-for="InitialAmount" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <small class="text-muted mt-1 d-block">A main account will be automatically created with this amount</small>
                        </div>
                    </div>
                </div>

                <hr class="divider my-4" />

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-controller="User" asp-action="Index" class="btn-artemis btn-ghost-artemis">
                        <i class="fa-solid fa-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn-artemis btn-primary-artemis">
                        <i class="fa-solid fa-floppy-disk"></i> Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const r = document.getElementById('roleSelect'),
              s = document.getElementById('initialAmountSection');
        if (r && s) {
            r.addEventListener('change', function () {
                s.style.display = this.value === 'Client' ? 'block' : 'none';
            });
        }
    </script>
}
