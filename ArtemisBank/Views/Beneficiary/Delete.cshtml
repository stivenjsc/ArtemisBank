@model BeneficiaryViewModel
@{
    ViewData["Title"] = "Delete Beneficiary";
}

<div class="breadcrumb-artemis mb-3">
    <a asp-controller="Client" asp-action="Index">My Banking</a> /
    <a asp-controller="Beneficiary" asp-action="Index">Beneficiaries</a> / Delete
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="table-card border-danger">
            <div class="table-card-header bg-light">
                <h5 class="text-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Confirm Deletion
                </h5>
            </div>

            <div class="p-4 text-center">
                <p class="mb-4">Are you sure you want to remove this beneficiary from your list?</p>

                <div class="stat-card mb-4 bg-light">
                    <div class="stat-label">Beneficiary Details</div>
                    <div class="stat-value" style="font-size:1.2rem">@Model.Alias</div>
                    <div class="text-muted" style="letter-spacing:1px">Account: @Model.AccountNumber</div>
                </div>

                <form asp-controller="Beneficiary" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex justify-content-around">
                        <a asp-action="Index" class="btn-artemis btn-ghost-artemis">
                            <i class="fa-solid fa-arrow-left me-1"></i> No, Keep it
                        </a>

                        <button type="submit" class="btn-artemis btn-danger-artemis">
                            <i class="fa-solid fa-trash-can me-1"></i> Yes, Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>