@model ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Restablecer contraseña</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Artemis.css" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-logo"><i class="fa-solid fa-key"></i></div>
            <h1 class="login-title">Reset access</h1>
            <p class="login-subtitle">Enter your username to receive the link</p>
            @if (Model.HasError)
            {
                <div class="alert-artemis alert-artemis-danger mb-3"><i class="fa-solid fa-circle-exclamation"></i> @Model.Error</div>
            }
            <form asp-controller="Login" asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label class="form-label">Nombre de usuario</label>
                    <input asp-for="Username" class="form-control" placeholder="Su nombre de usuario" />
                    <span asp-validation-for="Username" class="text-danger" style="font-size:.78rem"></span>
                </div>
                <button type="submit" class="btn-artemis btn-primary-artemis w-100 justify-content-center py-2">
                    <i class="fa-solid fa-paper-plane"></i> Enviar instrucciones
                </button>
            </form>
            <div class="text-center mt-4">
                <a asp-controller="Login" asp-action="Index" style="color:var(--emerald-600);font-size:.82rem;text-decoration:none">
                    <i class="fa-solid fa-arrow-left me-1"></i>Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>
</body>
</html>